{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // 서브모듈로 들어온 사내 공용 화면 조각(vendor/dss-ui, 별도 저장소).
      // 저장소 안의 소스라 Next 가 제 앱 코드처럼 컴파일한다 —
      // transpilePackages 도 Tailwind @source 도 필요 없다(그쪽 README 5절).
      "@dss/ui": ["./vendor/dss-ui/src/index.ts"],
      "@dss/ui/styles.css": ["./vendor/dss-ui/src/service-menu/service-menu.css"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
