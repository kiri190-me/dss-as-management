# 이 파일은 예시용이며 실제 값이 아닙니다. 절대 실제 키/시크릿을 이 파일에 넣지 마세요.
# 실제 값은 .env.local(Git 추적 제외)에만 저장합니다.

NEXT_PUBLIC_APP_ENV=demo

# 세션 서명에 사용하는 비밀 키(HMAC-SHA256). 실제 값은 .env.local에서만 설정합니다.
AUTH_SESSION_SECRET=

# 데모 로그인 UI/라우트 활성화 여부. 정확히 "true"일 때만 활성화되며,
# 운영 환경에서는 절대 true로 설정하지 않습니다.
DEMO_LOGIN_ENABLED=false

# 로그인/세션→사용자 조회가 어디서 계정을 읽을지 결정합니다.
# "mock"(미설정 시 기본값) 또는 "database". Never NEXT_PUBLIC_. "database"
# 모드에서는 session.userId가 항상 실제 users.id UUID입니다 — see
# src/lib/config/auth-source.ts.
AUTH_SOURCE=mock

# --- Docker Compose / Database (Stage G-1, local dev) ---
# 실제 값은 .env.local에만 저장합니다. 아래는 자리표시자(placeholder)입니다.
DATABASE_URL=postgresql://dss_app:CHANGE_ME@127.0.0.1:5432/dss_as_dev
# DB integration tests only. Must be a separate local database whose name
# ends in _test; using DATABASE_URL here is rejected before any mutation.
TEST_DATABASE_URL=postgresql://dss_app:CHANGE_ME@127.0.0.1:5432/dss_as_test
UPLOADS_DIR=C:\DSS-AS-DATA\uploads
BACKUPS_DIR=C:\DSS-AS-DATA\backups
LOGS_DIR=C:\DSS-AS-DATA\logs

# --- 견적서 양식 (넷) ---
# 원본 xlsx 에 법인 직인 이미지·계좌번호·사업자 정보가 들어 있어 저장소에
# 커밋하지 않습니다. 각자 이 경로에 양식을 두고 아래를 실제 경로로 채우세요.
# 프로그램은 이 파일을 읽기만 하고 절대 쓰지 않습니다.
# OneDrive 안을 직접 가리키지 마세요 — 동기화 중 파일 잠김이 납니다.
#
# 양식은 **장비 종류 × 견적서 종류로 넷**이고 기본 문구가 넷 다 다릅니다
# (2026-08-31 실측). 특히 납기가 전부 갈립니다:
#   제너레이터 내자  발주일로부터 3주 이내
#   제너레이터 OH    발주일로부터 4주 이내
#   매쳐 내자        발행일로 부터 약 3개월 이내
#   매쳐 OH          발행일로 부터 6주
#
# 매쳐 양식은 셀 자리도 다릅니다(유효기간 D17·납기 D18·결재조건 D19·계좌 D20,
# 시트 이름은 둘 다 `견적서`). 제너레이터는 D15~D18 · `내자견적서`/`OH견적서`.
#
# 접두사가 없는 둘은 **제너레이터**입니다 — 이미 쓰이던 이름이라 그대로 둡니다.
# 파일 이름은 아래와 달라도 됩니다. 실제로 디스크에 있는 이름과 맞기만 하면 됩니다.
QUOTE_TEMPLATE_PATH=C:\DSS-AS-DATA\templates\제너레이터 내자 견적서.xlsx
OH_QUOTE_TEMPLATE_PATH=C:\DSS-AS-DATA\templates\제너레이터 OH 견적서.xlsx
MATCHER_QUOTE_TEMPLATE_PATH=C:\DSS-AS-DATA\templates\매쳐 내자 견적서.xlsx
MATCHER_OH_QUOTE_TEMPLATE_PATH=C:\DSS-AS-DATA\templates\매쳐 OH 견적서.xlsx

# --- 케이블 견적서 양식 (다섯째) ---
# 🔴 위 넷과 달리 **장비 종류와 무관한 별도 견적서**입니다(수리품과 이어지지
# 않습니다). 작업 범위 구역이 없고 품목 표 하나뿐이며, 규격 칸과 특이사항이
# 있습니다. 셀 자리도 회사 정보까지 달라서 따로 읽습니다
# (src/lib/storage/quote-template.ts 의 CABLE_HEADER_CELLS).
#
# 값은 비워 둡니다 — 이 저장소는 공개이므로 실제 경로는 .env.local 에만 적습니다.
# 다른 양식들과 같은 폴더에 두고, 디스크에 있는 파일 이름과 맞기만 하면 됩니다.
CABLE_QUOTE_TEMPLATE_PATH=

# --- 검사 보고서 · 수리 보고서 양식 (둘) ---
# 견적서 양식과 같은 규칙입니다 — 저장소에 커밋하지 않고, 읽기만 하고,
# OneDrive 안을 직접 가리키지 않습니다(동기화 중 파일 잠김).
#
# 두 파일은 **같은 통합문서**이고 다른 곳이 셋뿐입니다(2026-09-01 실측):
#   C11 제목 `검　사　보　고　서` / `수　리　보　고　서` (공백은 전각)
#   X28 조치 완료 체크 · AF28 조치 완료 날짜 — 수리에만
# 그래도 파일을 둘로 두는 이유는, 이 파일들이 빈 양식이 아니라 **발행본
# 사본**이라 서식·직인·인쇄 설정이 각각 그 종류에 맞춰져 있기 때문입니다.
#
# 값을 채우는 시트 이름은 둘 다 `Repair_Report (한글)` 입니다
# (통합문서에는 `List`(숨김)·`Repair_Record`·`oh 참고` 도 들어 있습니다).
INSPECTION_REPORT_TEMPLATE_PATH=C:\DSS-AS-DATA\templates\검사보고서.xlsx
REPAIR_REPORT_TEMPLATE_PATH=C:\DSS-AS-DATA\templates\수리보고서.xlsx

# --- Stage G-2: repair-case read source (server-only) ---
# "mock" or "database" ("mock" if absent). Never NEXT_PUBLIC_. Any other
# value throws clearly at read time — see src/lib/config/read-source.ts.
# This template ships "database" because intake registration is rejected
# unless reads come from the database too (see create-repair-case action);
# "mock" stays a valid value for demo/browsing-only setups.
REPAIR_CASE_READ_SOURCE=database

# --- Stage G-3: repair-case write source (server-only) ---
# "database" is the only accepted value (also the default if absent). Never
# NEXT_PUBLIC_. The former "local" browser-demo write path was removed, so
# "local" now throws clearly at read time, like any other invalid value — see
# src/lib/config/write-source.ts. Writes additionally require
# REPAIR_CASE_READ_SOURCE=database, which is what this template sets above.
REPAIR_CASE_WRITE_SOURCE=database

# --- 통합 로그인(SSO, dss-auth) ---
# 신원을 무엇으로 증명하는가. AUTH_SOURCE("계정을 어디서 읽는가")와는 다른
# 축이다 — SSO를 켜도 계정은 여전히 데이터베이스에서 읽으므로 AUTH_SOURCE는
# "database" 그대로 둔다. 자세한 이유는 src/lib/config/login-mode.ts 참조.
# "demo"(미설정 시 기본값) 또는 "sso".
LOGIN_MODE=demo

# DSS 통합 로그인 서버 주소. ID 토큰의 iss 클레임과 문자 단위로 같아야 한다.
SSO_ISSUER=http://localhost:3100
# dss-auth에서 발급받은 값. 실제 값은 .env.local에만 넣는다.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# dss-auth에 등록한 값과 문자 단위로 정확히 같아야 한다.
# 요청(request.url)에서 만들어 쓰지 않는다 — LAN/프록시 환경에서 실제와 다른
# 값이 나오는 사례가 이 저장소에서 이미 실측되었다.
#
# 🔴 이 값은 "밖에서 이 앱에 닿는 주소"이기도 하다. 통합 알림 통로
# (/api/integration/notifications)가 알림 링크를 절대 주소로 만들 때 여기서 앞부분을
# 얻는다(끝의 /api/auth/sso/callback을 떼어 쓴다 — config/sso.ts의 getAppBaseUrl).
# 따로 변수를 두지 않는 이유는 둘이 어긋나면 "다른 사이트의 종에서 누르면 엉뚱한
# 데로 간다"는 증상 하나로만 나타나기 때문이다.
SSO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback

# ── A/S 접수 알림 메일(SMTP) ───────────────────────────────────────────────
# 비우면 메일 기능만 꺼집니다 — 접수·화면은 그대로 동작합니다.
MAIL_SMTP_HOST=
# 587=STARTTLS, 465=SSL 이 보통입니다.
MAIL_SMTP_PORT=587
# starttls | ssl | none. 안 적으면 포트에서 추론합니다(465면 ssl, 그 외 starttls).
MAIL_SMTP_SECURE=starttls
# 호스팅에 따라 아이디만("chm") 쓰기도 하고 전체 주소를 쓰기도 합니다.
# 어느 쪽인지는 `npm run mail:check` 로 확인합니다.
MAIL_SMTP_USER=
# 실제 값은 .env.local에만 넣습니다.
MAIL_SMTP_PASSWORD=
# 수신자 메일함에 뜨는 이름. "DSS A/S 시스템 <as@example.com>" 형태.
MAIL_FROM=
# 옛 TLS(1.0/1.1)만 지원하는 서버에 붙어야 할 때만 "true". 카페24가 그렇습니다.
# 프로토콜 버전만 낮추고 인증서 검증은 그대로 유지합니다 — 자세한 내용은
# src/lib/server/mail/config.ts 의 legacyTls 주석에 있습니다.
MAIL_SMTP_LEGACY_TLS=false

# ── 견적서 공유폴더 저장 ─────────────────────────────────────────────────────
# 견적서 파일 · 결재 PDF 를 사내 공유폴더의 연도 폴더 › 견적서 폴더에 사본으로
# 저장할 때의 루트입니다. 비우면 공유폴더 저장 기능만 꺼집니다 — 견적서 작성 ·
# 내려받기는 그대로 동작합니다.
# 운영에서는 컨테이너에 연결(마운트)한 공유폴더의 컨테이너 안 경로를 적습니다.
# 루트는 앱이 만들지 않습니다 — 연결이 빠져 폴더가 없으면 저장이 실패로 끝납니다
# (없는 루트를 만들면 컨테이너 안 임시 디스크에 저장하게 되기 때문입니다).
# 실제 경로는 .env.local 에만 넣습니다.
QUOTE_ARCHIVE_DIR=

# 사람이 Windows 탐색기에서 보는 공유폴더 루트입니다 — QUOTE_ARCHIVE_DIR 과 같은 곳을
# UNC 경로(\\NAS이름\공유이름\…) 모양으로 적습니다. 견적서 화면 [폴더 열기]의 도우미 설치
# 파일(현재 사용자에게만 설치 · 관리자 권한 없음)에만 들어갑니다 — 서버 응답에는 싣지 않습니다.
# 비우면 도우미 설치 파일을 받을 수 없습니다(견적서 저장 · 내려받기는 그대로 동작합니다).
# 값을 바꾸면 각 PC 에서 설치 파일을 새로 받아 다시 실행해야 새 루트가 적용됩니다.
# 실제 경로는 .env.local 에만 넣습니다.
QUOTE_ARCHIVE_UNC_ROOT=

# 같은 공유폴더를 가리키는 **다른 주소**입니다 — 이름(\DSS-NAS…)과 IP(\192.168.0.222…)처럼.
# 비워 두어도 됩니다. 도우미는 위 주소로 먼저 열어 보고, 못 열면 이 주소로 한 번 더 해 봅니다.
# 이름 풀이가 안 되는 PC 가 섞여 있으면 하나만 두었을 때 그 PC 에서는 [폴더 열기]가 통째로 먹통이 됩니다.
# 잘못 적으면 없는 셈 칩니다 — 위 주소만으로 동작합니다.
QUOTE_ARCHIVE_UNC_ROOT_ALT=

# ── 연락서 공유폴더 ──────────────────────────────────────────────────────────
# 수리 건 하나에 폴더 하나가 있는 사내 공유폴더입니다(`D260908 고객사 모델 L/N S/N 증상`).
# 수리 건 상세의 [폴더 열기]가 **인수번호 하나로** 그 폴더를 찾습니다.
# 🔴 **견적서 폴더(QUOTE_ARCHIVE_DIR)와 다른 곳입니다.** 견적서 설정을 그대로 쓰지 마세요.
# 비우면 이 기능만 꺼집니다 — 수리 건 조회 · 파일 관리는 그대로 동작합니다.
# 운영에서는 컨테이너에 연결(마운트)한 공유폴더의 컨테이너 안 경로를 적습니다.
# 루트는 앱이 만들지 않습니다 — 연결이 빠져 폴더가 없으면 찾기가 실패로 끝납니다
# (없는 루트를 만들면 컨테이너 안 임시 디스크를 보고 "없습니다"라고 거짓말하게 됩니다).
# 🔴 앱은 이 폴더를 **읽기만** 합니다 — 지금 단계에서는 폴더를 만들지도 지우지도 않습니다.
# 실제 경로는 .env.local 에만 넣습니다.
CONTACT_FOLDER_ARCHIVE_DIR=

# 사람이 Windows 탐색기에서 보는 **연락서 쪽 공유폴더 루트**입니다(UNC).
# 왜 따로 두는가: 탐색기를 여는 도우미는 PC 마다 **한 벌만** 설치됩니다(레지스트리 dss-folder ·
# %LOCALAPPDATA%\DSS\open-dss-folder.ps1). 연락서용 도우미를 따로 설치하면 그 PC 의 견적서
# [폴더 열기]가 죽습니다. 그래서 설치 파일에는 견적서 루트 · 현황표 루트와 이 루트를 **함께**
# 심고, 도우미가 차례로 해 봅니다(연락서는 맨 뒤). 「루트 밖은 열지 않는다 · 바로 가기 폴더는
# 열지 않는다」는 검사는 **루트마다 따로** 그대로 돕니다(src/lib/server/quote-folder-helper.ts).
# 🔴 도우미가 열 수 있는 범위가 곧 이 루트 아래 전부입니다 — **될 수 있는 대로 좁게** 적습니다
# (공유 뿌리가 아니라 연락서 폴더들이 모여 있는 바로 그 폴더까지).
# 🔴 이 값은 **도우미 설치본에만** 들어갑니다 — 서버 응답에도 로그에도 나가지 않습니다.
# 🔴 값을 바꾸면 각 PC 에서 설치 명령을 새로 받아 다시 실행해야 새 루트가 적용됩니다.
# 잘못 적으면 없는 셈 칩니다 — 견적서 [폴더 열기]는 그대로 동작합니다.
# 실제 경로는 .env.local 에만 넣습니다.
CONTACT_FOLDER_ARCHIVE_UNC_ROOT=

# 사람이 탐색기 주소창에 붙여넣을 **전체 주소**입니다(\\NAS이름\공유\…\2. 연락서).
# 도우미 설치가 막힌 PC 를 위한 우회로로, 적어 두면 화면에 [위치 복사] 단추가 생깁니다.
# 🔴 **이 값만 화면(응답)으로 나갑니다** — 수리 건의 파일을 볼 수 있는 사내 사용자에게만 갑니다.
# 서버는 여기에 폴더 이름을 이어 붙이지 않습니다 — 적힌 값 그대로 나갑니다(사람이 그 안에서
# 제 인수번호 폴더를 찾습니다).
# 사내 폴더 구조를 브라우저로 내보내고 싶지 않으면 **비워 두세요**. 비우면 단추 자체가 없습니다.
CONTACT_FOLDER_ARCHIVE_UNC_PATH=

# ── 고객사 현황표(업체별 수리품현황) 공유폴더 ────────────────────────────────
# 「고객 안내 현황」의 고객사 양식 표를 엑셀로 내보내 저장하는 폴더입니다. 비우면
# [엑셀 미리보기] · [공유폴더에 저장]만 꺼집니다 — 화면의 표와 고객 안내는 그대로입니다.
# 🔴 **견적서 폴더(QUOTE_ARCHIVE_DIR)와 다른 곳입니다.** 견적서 설정을 그대로 쓰지 마세요.
# 운영에서는 컨테이너에 연결(마운트)한 공유폴더의 컨테이너 안 경로를 적습니다.
# 루트는 앱이 만들지 않습니다 — 연결이 빠져 폴더가 없으면 저장이 실패로 끝납니다.
# 이 폴더에서 **맨 위 칸의 파일만** 봅니다(옛 판을 모아 둔 OLD 하위 폴더는 보지 않습니다).
# 앱은 이 폴더의 파일을 **지우거나 덮어쓰지 않습니다** — 언제나 만든 날짜가 붙은 새
# 이름으로만 저장하고, 같은 이름이 있으면 " (2)" 로 넘어갑니다.
# 실제 경로는 .env.local 에만 넣습니다.
CUSTOMER_PORTAL_ARCHIVE_DIR=

# 사람이 Windows 탐색기에서 보는 **현황표 쪽 공유폴더 루트**입니다(UNC). 아래 FOLDER_PATH 가
# 이 루트를 기준으로 한 상대 경로입니다 — 「이 루트 + FOLDER_PATH = UNC_PATH」가 되게 적습니다.
# 왜 따로 두는가: 탐색기를 여는 도우미는 PC 마다 **한 벌만** 설치됩니다(레지스트리 dss-folder ·
# %LOCALAPPDATA%\DSS\open-dss-folder.ps1). 현황표용 도우미를 따로 설치하면 견적서 [폴더 열기]가
# 그 PC 에서 죽습니다. 그래서 설치 파일에는 견적서 루트와 이 루트를 **함께** 심고, 도우미가
# 차례로 해 봅니다. 「루트 밖은 열지 않는다 · 바로 가기 폴더는 열지 않는다」는 검사는 **루트마다
# 따로** 그대로 돕니다(src/lib/server/quote-folder-helper.ts).
# 🔴 도우미가 열 수 있는 범위가 곧 이 루트 아래 전부입니다 — **될 수 있는 대로 좁게** 적습니다
# (공유 뿌리가 아니라 현황표 폴더의 바로 위 폴더까지).
# 현황표 폴더가 QUOTE_ARCHIVE_UNC_ROOT 아래에 있다면 비워 두어도 됩니다(견적서 루트로 열립니다).
# 🔴 값을 바꾸면 각 PC 에서 설치 명령을 새로 받아 다시 실행해야 새 루트가 적용됩니다.
# 잘못 적으면 없는 셈 칩니다 — 견적서 [폴더 열기]는 그대로 동작합니다.
# 실제 경로는 .env.local 에만 넣습니다.
CUSTOMER_PORTAL_ARCHIVE_UNC_ROOT=

# 위 현황표 루트를 가리키는 **다른 주소**입니다 — 이름(\DSS-NAS…)과 IP(\192.168.0.222…)처럼.
# 까닭은 QUOTE_ARCHIVE_UNC_ROOT_ALT 와 같습니다: 이름 풀이가 안 되는 PC 가 섞여 있으면 하나만
# 두었을 때 그 PC 에서 이 폴더가 안 열립니다. 비워 두어도 되고, 잘못 적으면 없는 셈 칩니다.
CUSTOMER_PORTAL_ARCHIVE_UNC_ROOT_ALT=

# [폴더 열기]가 쓸 경로입니다 — **폴더 열기 도우미의 루트를 기준으로 한 상대 경로**를 구분자
# `/` 로 적습니다(예: `3. 업체별 수리품현황`). 기준이 되는 루트는 위 CUSTOMER_PORTAL_ARCHIVE_UNC_ROOT
# 이고, 그 값을 비웠다면 견적서 루트(QUOTE_ARCHIVE_UNC_ROOT)입니다 — 도우미는 심어 둔 루트를
# 차례로 해 보고 **처음으로 실제 있는 폴더**를 엽니다. 어느 루트 아래도 아니면 열지 않습니다.
# 🔴 그러므로 이 폴더는 심어 둔 루트 가운데 하나의 **아래**에 있어야 합니다. 아니라면 도우미가
# "폴더를 찾을 수 없습니다"로 끝내므로, 그때는 아래 UNC_PATH 를 적어 [위치 복사]로 쓰세요.
# 비우면 [폴더 열기]가 "설정되지 않았습니다"만 알립니다(저장 · 미리보기는 그대로 동작합니다).
# `..` · 드라이브 문자 · `\ : * ? " < > |` 가 들어가면 없는 셈 칩니다(도우미가 받지 않는 경로입니다).
CUSTOMER_PORTAL_ARCHIVE_FOLDER_PATH=

# 사람이 탐색기 주소창에 붙여넣을 **전체 주소**입니다(\\NAS이름\공유\…\3. 업체별 수리품현황).
# 도우미 설치가 막힌 PC 를 위한 우회로로, 적어 두면 화면에 [위치 복사] 단추가 생깁니다.
# 🔴 이 값은 화면(응답)으로 나갑니다 — 고객 안내 현황을 볼 수 있는 사내 사용자에게만 갑니다.
# 사내 폴더 구조를 브라우저로 내보내고 싶지 않으면 **비워 두세요**. 비우면 단추 자체가 없습니다.
# (견적서 쪽도 같은 갈래를 씁니다 — api/quotes/{id}/archive-folder 의 uncPath.)
CUSTOMER_PORTAL_ARCHIVE_UNC_PATH=
