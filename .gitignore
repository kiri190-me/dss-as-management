# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is a safe placeholder template and is tracked)
.env
.env.local
.env.*.local
!.env.example

# Local database safety backups contain database data and must never be
# committed. Keep the directory available for timestamped pg_dump files.
backups/

# raw PostgreSQL dump/backup files, wherever they end up in the tree
*.dump
*.backup

# local-only agent working notes; never intended for the published repo
AGENTS.md
HANDOFF.md

# vercel
.vercel

# generated purge-job logs (scripts/run-nightly-purge.ps1)
/logs/

# typescript
*.tsbuildinfo
next-env.d.ts
