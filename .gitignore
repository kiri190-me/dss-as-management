# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is a safe placeholder template and is tracked)
#
# .env* 로 통째로 막는 이유: 예전에는 .env / .env.local / .env.*.local 세
# 가지만 적혀 있었는데, 그러면 .env.local.bak / .env.old / .env.backup 같은
# 파일이 그물을 빠져나간다. 실제로 작업 중 만들어진 .env.local.bak이 추적
# 대상으로 잡히는 것을 확인했다 — 비밀값이 그대로 든 파일이다.
.env*
!.env.example

# Local database safety backups contain database data and must never be
# committed. Keep the directory available for timestamped pg_dump files.
backups/

# raw PostgreSQL dump/backup files, wherever they end up in the tree
*.dump
*.backup

# local-only agent working notes; never intended for the published repo
AGENTS.md
HANDOFF.md

# vercel
.vercel

# generated purge-job logs (scripts/run-nightly-purge.ps1)
/logs/

# typescript
*.tsbuildinfo
next-env.d.ts

# 견적서 원본 양식. 법인 직인 이미지·계좌번호·사업자등록번호·대표자 성명이
# 들어 있어 저장소에 올리지 않는다. 경로는 QUOTE_TEMPLATE_PATH 로 준다.
*.xlsx
*.xls
